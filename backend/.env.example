# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon/Supabase/Render free tier)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/healthcare_db?sslmode=require"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your_access_token_secret_min_32_chars
JWT_REFRESH_SECRET=your_refresh_token_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Redis (BullMQ background jobs) ───────────────────────────────────────────
# Upstash free tier: copy the rediss:// URL from your Upstash dashboard
REDIS_URL=redis://localhost:6379
# Set to "true" to disable BullMQ and fall back to node-cron (no Redis needed)
USE_CRON_FALLBACK=false

# ─── Email (SMTP / SendGrid) ──────────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
EMAIL_FROM=noreply@yourclinic.com
EMAIL_FROM_NAME=HealthCare Clinic

# ─── LLM (OpenAI-compatible) ──────────────────────────────────────────────────
LLM_API_KEY=your_openai_or_compatible_api_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=10000

# ─── Google Calendar OAuth 2.0 ────────────────────────────────────────────────
# Create OAuth 2.0 credentials in Google Cloud Console
# Authorized redirect URI: http://localhost:4000/api/calendar/oauth/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/calendar/oauth/callback
