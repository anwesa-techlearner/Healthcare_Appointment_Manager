# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon/Supabase/Render free tier)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/healthcare_db?sslmode=require"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (no spaces around commas)
# Local dev:
FRONTEND_URL=http://localhost:5173
# Production example (add all your Vercel URLs):
# FRONTEND_URL=https://healthcare-appointment-manager-eight.vercel.app,https://healthcare-appointment-manager-fhwzib6ad-anwesa-s-projects.vercel.app,http://localhost:5173

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your_access_token_secret_min_32_chars
JWT_REFRESH_SECRET=your_refresh_token_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Redis (BullMQ background jobs) ───────────────────────────────────────────
# Upstash free tier: copy the rediss:// URL from your Upstash dashboard
REDIS_URL=redis://localhost:6379
# Set to "true" to disable BullMQ and fall back to node-cron (no Redis needed)
USE_CRON_FALLBACK=false

# ─── Email (SMTP / SendGrid) ──────────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
EMAIL_FROM=noreply@yourclinic.com
EMAIL_FROM_NAME=HealthCare Clinic

# ─── LLM (OpenAI-compatible) ──────────────────────────────────────────────────
# Supports any OpenAI-compatible API. Three tested options:
#
# Option A — Google Gemini (recommended, free tier available)
#   Get your API key at: https://aistudio.google.com/apikey
#   Free tier: gemini-2.5-flash = 10 RPM / 250 RPD, gemini-2.5-flash-lite = 15 RPM / 1000 RPD
LLM_API_KEY=your_gemini_api_key_from_ai_studio
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_MS=15000
#
# Option B — OpenAI
# LLM_API_KEY=sk-your_openai_key
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_MS=10000
#
# Option C — Groq (free tier, very fast)
# LLM_API_KEY=your_groq_key
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-8b-instant
# LLM_TIMEOUT_MS=10000

# ─── Google Calendar OAuth 2.0 ────────────────────────────────────────────────
# Create OAuth 2.0 credentials in Google Cloud Console
# Authorized redirect URI: http://localhost:4000/api/calendar/oauth/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/calendar/oauth/callback
